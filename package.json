{
  "name": "kamaui-care-validador-apk",
  "version": "1.2.0",
  "description": "Kamaui — Validador Express de Ideas 360°, Dossier I+D y Portafolio de Proyectos (Versión Web & Android APK)",
  "main": "kamaui-mobile-apk.html",
  "scripts": {
    "prepare:www": "node -e \"const fs=require('fs'); fs.mkdirSync('www/assets',{recursive:true}); fs.copyFileSync('kamaui-mobile-apk.html','www/index.html'); fs.copyFileSync('kamaui-mobile-apk.html','www/kamaui-mobile-apk.html'); fs.copyFileSync('index.html','www/desktop.html'); fs.copyFileSync('landing-template.html','www/landing-template.html'); fs.copyFileSync('manifest.json','www/manifest.json'); fs.copyFileSync('sw.js','www/sw.js'); if(fs.existsSync('assets/logo-kamaui.jpg')) fs.copyFileSync('assets/logo-kamaui.jpg','www/assets/logo-kamaui.jpg');\"",
    "apk:init": "npm run prepare:www && npx cap add android && npx cap sync android",
    "apk:assets": "node -e \"const fs=require('fs'); fs.mkdirSync('resources',{recursive:true}); fs.copyFileSync('www/assets/logo-kamaui.jpg','resources/icon.png'); fs.copyFileSync('www/assets/logo-kamaui.jpg','resources/splash.png');\" && npx capacitor-assets generate --android --iconBackgroundColor \"#F7F5F0\" --splashBackgroundColor \"#5C3A21\"",
    "apk:sync": "npm run prepare:www && npx cap sync android",
    "apk:open": "npx cap open android"
  },
  "dependencies": {
    "@capacitor/android": "^6.1.2",
    "@capacitor/core": "^6.1.2"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^6.1.2"
  }
}
